# Port d'écoute du microservice
PORT=3002

# URL de connexion MongoDB (la base n'est pas fournie : à adapter à votre installation)
MONGO_URI=mongodb://localhost:27017/device_service_db

# Authentification JWT (fournie par l'Auth Service)
# false = routes ouvertes (pratique pour tester avec Postman)
# true  = un jeton "Authorization: Bearer <token>" est exigé
AUTH_ENABLED=false
JWT_SECRET=change_me_same_secret_as_auth_service
